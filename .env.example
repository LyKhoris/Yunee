# Yunee — environment template. Copy to .env.local and fill in.
# NEVER commit .env.local.

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Public base URL, used to build the invite links the members CLI prints.
APP_URL=http://localhost:3000

# --- Turso Cloud (https://turso.tech) ---
# Leave blank in development: the app falls back to a local SQLite file at
# data/yunee.db. Set both in production (Vercel -> Project -> Settings -> Env).
#
#   turso db show --url yunee        -> TURSO_DATABASE_URL
#   turso db tokens create yunee     -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
