# Yunee — environment template. Copy to .env.local and fill in.
# NEVER commit .env.local.

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Base URL used to build invite links shown by the members CLI.
APP_URL=http://localhost:3000

# --- Turso Cloud (https://turso.tech) ---
# Leave both blank in development: the app falls back to a local SQLite file
# at data/yunee.db, which speaks the same SQL.
#
#   turso db show --url yunee           -> TURSO_DATABASE_URL
#   turso db tokens create yunee        -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
